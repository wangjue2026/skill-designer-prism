    "names": "对象名 / 组织名 / 应用名 / 终端名",
    "states": "状态词（正常 / 告警 / 严重 / 离线 / 未纳管 …）",
    "times": "时间 / 时长",
    "copy": "标题 / 副标题 / 说明文案",
    "icons": "图标语义槽：形状必须按新需求重画，尺寸 / 线宽 / 底色 / 色值不动"
  },
