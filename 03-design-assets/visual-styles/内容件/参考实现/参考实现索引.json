{
  "version": "2026-11-07",
  "note": "键 → 参考实现页 + 选择器 + 填空槽位。本索引只登记「哪段是业务内容」，不复制样式；样式唯一真源仍是 pages/ 下的整页 CSS 与 件型落地契约.json。",
  "slotTaxonomy": {
    "values": "数值（计数 / 百分比 / 时延 / 总量）",
